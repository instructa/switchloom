---
import "@/styles/global.css";
import Generator from "@/components/Generator";
import { workflowFromCatalog } from "@/lib/generator";
import catalog from "../../data/catalog.json";

const workflow = workflowFromCatalog(catalog);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Assign capabilities to GPT models in persistent Codex tasks. Copy one workflow prompt, with optional Jev routing." />
    <meta name="theme-color" content="#f7f5ef" />
    <link rel="canonical" href="https://switchloom.ai/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Switchloom" />
    <meta property="og:url" content="https://switchloom.ai/" />
    <meta property="og:title" content="Switchloom — Your workflow." />
    <meta property="og:description" content="Assign capabilities to GPT models in persistent Codex tasks. Copy one workflow prompt, with optional Jev routing." />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Switchloom — Your workflow." />
    <meta name="twitter:description" content="Assign capabilities to GPT models in persistent Codex tasks. Copy one workflow prompt, with optional Jev routing." />
    <link rel="icon" href="/brand/codex.svg" type="image/svg+xml" />
    <script is:inline defer data-domain="switchloom.ai" src="https://analytics.int.macherjek.com/js/script.js"></script>
    <title>Switchloom — Your workflow.</title>
  </head>
  <body>
    <Generator client:load workflow={workflow} />
  </body>
</html>
