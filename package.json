{
  "name": "switchloom",
  "version": "1.0.0",
  "description": "Codex model routing and task handoffs with TypeSafe/Jev.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instructa/switchloom.git"
  },
  "homepage": "https://github.com/instructa/switchloom#readme",
  "bugs": "https://github.com/instructa/switchloom/issues",
  "type": "module",
  "bin": {
    "switchloom": "npm/bin/model-routing.js",
    "model-routing": "npm/bin/model-routing.js"
  },
  "files": [
    "npm/bin/model-routing.js",
    "npm/native/darwin-arm64/model-routing",
    "npm/native/darwin-x86_64/model-routing",
    "npm/native/linux-arm64/model-routing",
    "npm/native/linux-x86_64/model-routing",
    "npm/native/provenance.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "catalog:regenerate": "cargo run --quiet -p xtask -- release prepare --allow-dirty",
    "deploy:test": "pnpm site:check && alchemy deploy --stage test",
    "distribution:test": "node --test npm/*.test.mjs scripts/release.test.mjs && pnpm pack:check",
    "destroy:test": "alchemy destroy --stage test",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:check-sensitive": "node scripts/hooks/block-sensitive-diff-content.mjs --worktree",
    "pack:check": "cargo run --quiet -p xtask -- release verify --inventory-only --require-provenance",
    "security:check": "bash scripts/secleak-check.sh",
    "site:build": "pnpm site:core && vite build",
    "site:check": "pnpm site:core && vitest run && vite build && tsc --noEmit",
    "site:dev": "pnpm site:core && vite --host 127.0.0.1",
    "site:test": "pnpm site:core && vitest run",
    "site:serve": "pnpm site:core && vite --host 127.0.0.1 --port 4173",
    "site:core": "node scripts/build-web-core.mjs",
    "site:local": "pnpm site:core && DEVELOPER_MODE=true vite --mode developer --host 127.0.0.1 --port 4173"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "alchemy": "0.93.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "@tanstack/react-start": "1.168.56",
    "@tanstack/react-router": "1.170.38",
    "@cloudflare/vite-plugin": "1.55.0",
    "@cloudflare/workers-types": "5.20260917.1",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.3.0",
    "wrangler": "4.134.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.5.3+sha512.7ac1c919341c213a34dc0d02afb7143c5c26ac26ee8c4782deea821b8ac64d2134a081fd8941dae6e29bbb48f58dfc2b7fbceeccc07cb2f09d219d342a4969ed"
}
